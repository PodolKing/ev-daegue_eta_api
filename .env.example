# --- Database ---
# local = MariaDB (DB_*) · supabase = Postgres (SUPABASE_DB_URL)
# Switch: DB_BACKEND=local | supabase
#DB_BACKEND=local
#SUPABASE연동이므로 밑의것을사용
DB_BACKEND=supabase

# local (MariaDB) — used when DB_BACKEND=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ev-daegue_eta

# supabase (Postgres) — used when DB_BACKEND=supabase
# Owner (direct URI; code rewrites to Session pooler ap-northeast-1 for IPv4):
#   postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres
# Teammate role (same host; user=teammate — pooler becomes teammate.<project-ref>):
#   postgresql://teammate:YOUR_TEAMMATE_PASSWORD@db.<project-ref>.supabase.co:5432/postgres
# Or paste Session pooler URI directly:
#   postgresql://teammate.<project-ref>:YOUR_TEAMMATE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Optional full override (wins over DB_BACKEND). Prefer DB_BACKEND + above.
# DATABASE_URL=

# --- Server ---
APP_ENV=development
# PC: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Optional override. Code default allows:
#   - http://localhost|127.0.0.1:3000–3009
#   - http://172.30.1.*:<port> (LAN phone)
# CORS_ORIGIN_REGEX=
# 소셜 콜백 후 리다이렉트 FE origin (로컬 http://localhost:3000 · Vercel https://….vercel.app)
FRONTEND_ORIGIN=http://localhost:3000

# --- TMAP REST (server-only: POI/place search, ETA, routing). Do NOT prefix NEXT_PUBLIC_ ---
# FE map SDK uses NEXT_PUBLIC_TMAP_MAP_KEY in web/.env.local — keep keys separate.
TMAP_APP_KEY=

# --- External data (collection / integrations) ---
DATA_GO_KR_KEY=
# Base service URL (code appends /getChargerStatus if needed)
EV_CHARGER_API_URL=https://apis.data.go.kr/B552584/EvCharger
# Collector: default false. Only ONE host should set true (not PC + Lightsail together).
EV_STATUS_SYNC_ENABLED=false
# EV_STATUS_INTERVAL_MINUTES=5
# EV_STATUS_PERIOD_MINUTES=5
# Daegu sido code (empty = nationwide)
# EV_STATUS_ZCODE=27
# EV_STATUS_NUM_OF_ROWS=9999
# Soft daily outbound cap for this process (status collect calls)
# EV_STATUS_DAILY_CALL_LIMIT=400
# KAKAO_REST_KEY=
# UTIC_API_KEY=

# --- 충전소 추천 모델 API (별도 서버). 키는 담당자 배포, git에 실값 금지 ---
RECOMMEND_API_BASE_URL=http://3.39.251.72:8000
RECOMMEND_API_TIMEOUT=10
RECOMMEND_API_KEY=

# --- Auth ---
# Local JWT (required for POST /api/v1/auth/login)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# itsdangerous OAuth state 서명
OAUTH_STATE_SECRET=
# AUTH_COOKIE_NAME=access_token

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
# Native SDK tokens: POST /api/v1/auth/kakao/native , POST /api/v1/auth/naver/native
# (Flutter app keys are not BE env — same Kakao/Naver app as REST client id.)

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/auth/naver/callback

# --- PortOne V2 (포인트 충전). 실키는 .env 로컬만, git 금지 ---
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
