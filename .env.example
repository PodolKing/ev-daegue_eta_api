# --- Database (assemble mysql+pymysql URL in config; DATABASE_URL wins if set) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ev-daegue_eta
# DATABASE_URL=

# --- Server ---
APP_ENV=development
# PC: http://localhost:3000
# Same-WiFi mobile: also add http://<PC-LAN-IP>:3000 (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- TMAP REST (server-only: POI/place search, ETA, routing). Do NOT prefix NEXT_PUBLIC_ ---
# FE map SDK uses NEXT_PUBLIC_TMAP_MAP_KEY in web/.env.local — keep keys separate.
TMAP_APP_KEY=

# --- External data (collection / integrations) ---
DATA_GO_KR_KEY=
# KAKAO_REST_KEY=
# UTIC_API_KEY=

# --- Auth ---
# Local JWT (required for POST /api/v1/auth/login)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Kakao OAuth — later only (not used for local signup/login)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=
