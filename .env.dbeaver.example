# DBeaver / GUI 클라이언트용 DB 접속 예시 (실비밀번호 넣지 말 것 · git 커밋 OK)
# 복사 후 로컬에만 비밀번호 기입. api/.env 의 SUPABASE_DB_URL 과는 별개 참고용.
#
# DBeaver: Database → New → PostgreSQL
#   아래 Host/Port/Database/Username/Password 를 그대로 매핑

# --- 추천: Session pooler (IPv4, Windows DBeaver에서 Direct보다 잘 됨) ---
DBEAVER_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DBEAVER_PORT=5432
DBEAVER_DATABASE=postgres
# pooler 사용자 형식: <role>.<project-ref>
DBEAVER_USER=teammate.qliwrbrcbxogfpemzuuc
DBEAVER_PASSWORD=

# SSL: DBeaver → SSL 탭 → SSL mode = require (또는 verify-full)

# --- 대안: Direct (IPv6만 되는 네트워크면 실패할 수 있음) ---
# DBEAVER_HOST=db.qliwrbrcbxogfpemzuuc.supabase.co
# DBEAVER_PORT=5432
# DBEAVER_DATABASE=postgres
# DBEAVER_USER=teammate
# DBEAVER_PASSWORD=

# --- FastAPI .env 로 쓸 때 (같은 계정, URI 한 줄) ---
# DB_BACKEND=supabase
# SUPABASE_DB_URL=postgresql://teammate.qliwrbrcbxogfpemzuuc:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
